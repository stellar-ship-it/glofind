Options -Indexes
<FilesMatch "^(config\.local\.php|config\.php|db\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
# api/_dev/ 는 INSTALL_KEY 로 보호된다. 설치 후 폴더를 삭제한다.
