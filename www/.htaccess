# 카페24(Apache) 이전용 — Vercel 에서는 .vercelignore 로 제외된다.
Options -Indexes
DirectoryIndex index.html index.php
RewriteEngine On

# 소스·설정·문서 직접 접근 차단
RewriteRule ^(\.git|admin/(lib|templates)) - [F]
<FilesMatch "^(config\.local\.php|CLAUDE\.md|README-handoff\.md|\.gitignore|\.vercelignore|vercel\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 옛 .html 주소 → 확장자 없는 폴더 주소로 301
# (IS_SUBREQ: DirectoryIndex 가 내부적으로 index.html 을 찾는 서브요청에는 적용하지 않아 무한 루프를 막는다)
RewriteCond %{IS_SUBREQ} false
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{IS_SUBREQ} false
RewriteRule ^(services|insights)/index\.html$ /$1/ [R=301,L]
RewriteCond %{IS_SUBREQ} false
RewriteRule ^(.+)\.html$ /$1/ [R=301,L]
